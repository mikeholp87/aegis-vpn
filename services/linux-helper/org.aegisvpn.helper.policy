<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Installed to /usr/share/polkit-1/actions/. The active local desktop user
     may change only the Aegis kill-switch table (same trust level as
     NetworkManager's network-control); anyone else needs an administrator. -->
<policyconfig>
  <vendor>Aegis VPN</vendor>
  <action id="org.aegisvpn.helper.killswitch">
    <description>Change the Aegis VPN kill switch</description>
    <message>Aegis VPN needs permission to block traffic outside the VPN tunnel</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/aegis-vpn/aegis-helper</annotate>
  </action>
</policyconfig>
